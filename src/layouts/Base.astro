---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/instrument-sans/index.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import '../styles/themes.css';

const {
  title = 'Aadya',
  description = 'Creative technologist building wearable, accessible interfaces.',
  theme = 'home',
} = Astro.props;
const path = Astro.url.pathname;
const isWork = path === '/' || path.startsWith('/projects');
---
<!doctype html>
<html lang="en" class={`t-${theme}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Aadya, home">Aadya</a>
      <nav aria-label="Main">
        <a href="/#work" aria-current={isWork ? 'page' : undefined}>Work</a>
        <a href="/about" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
        <a href="/cv" aria-current={path.startsWith('/cv') ? 'page' : undefined}>CV</a>
        <a href="/contact" aria-current={path.startsWith('/contact') ? 'page' : undefined}>Contact</a>
      </nav>
    </header>
    <slot name="backdrop" />
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p class="footer-mark">Aadya</p>
        <p>Creative technologist. Fashion, e-textiles, physical computing, and research.</p>
        <p class="footer-links"><a href="/#work">Work</a><a href="/about">About</a><a href="/cv">CV</a><a href="/contact">Contact</a></p>
        <p class="footer-meta">© 2026 Aadya <span aria-hidden="true">/</span> Built by hand, no trackers.</p>
      </div>
    </footer>
    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>
