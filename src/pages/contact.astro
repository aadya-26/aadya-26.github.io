---
import Base from '../layouts/Base.astro';
---
<Base title="Contact | Aadya" description="Get in touch with Aadya.">
  <section class="page wrap">
    <p class="kicker">Contact</p>
    <h1 class="statement">Say <em>hello.</em></h1>
    <p class="lede">For roles, collaborations, or questions about any of the projects.</p>
    <ul class="contact-list">
      <li><span class="mono">Email</span><span class="v todo">[EMAIL]</span></li>
      <li><span class="mono">LinkedIn</span><span class="v todo">[LINKEDIN URL]</span></li>
      <li><span class="mono">GitHub</span><a href="https://github.com/aadya-26">github.com/aadya-26</a></li>
      <li><span class="mono">Based in</span><span class="v">New York</span></li>
    </ul>
    <div class="btn-row">
      <a class="btn" href="/cv">View CV</a>
      <a class="btn" href="/about">About me</a>
    </div>
  </section>
</Base>
