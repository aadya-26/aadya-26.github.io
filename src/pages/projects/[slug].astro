---
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  const modules = import.meta.glob('../../projects/*.md', { eager: true });
  return Object.entries(modules).map(([path, mod]) => ({
    params: { slug: path.split('/').pop().replace('.md', '') },
    props: { project: mod },
  }));
}

const { project } = Astro.props;
const { Content, frontmatter } = project;
---
<Base title={`${frontmatter.title} | Aadya`} description={frontmatter.summary}>
  <article class="project">
    <h1>{frontmatter.title}</h1>
    <p class="tags">{frontmatter.tags}</p>
    <Content />
  </article>
</Base>